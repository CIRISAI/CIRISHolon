 "tip4p2005": {
  "source": "J. L. F. Abascal and C. Vega, 'A general purpose model for the condensed phases of water: TIP4P/2005', J. Chem. Phys. 123, 234505 (2005) -- the model-parameter table (TIP4P/2005 column): d(OH) = 0.9572 A, HOH = 104.52 deg, d(OM) = 0.1546 A, q(H) = 0.5564 e, sigma = 3.1589 A, eps/k_B = 93.2 K.",
  "parameters": {
   "d_oh_angstrom": 0.9572,
   "angle_hoh_degrees": 104.52,
   "d_om_angstrom": 0.1546,
   "q_h_e": 0.5564,
   "sigma_angstrom": 3.1589,
   "epsilon_over_kb_kelvin": 93.2
  },
  "placement_rule": "THE PLACEMENT RULE, stated: where the rigid model's sites go on a node's monomer.\n\n    `centers` is `[O, H1, H2]` in bohr, the record's own atoms.  The map's monomer is the\n    MINIMAL-BASIS relaxed water (O-H 1.943574 bohr, H-O-H 96.76 deg) and TIP4P/2005's is\n    its own (0.9572 A, 104.52 deg), so the two cannot both be honoured.  Two rules are run\n    and both are reported; neither is chosen by its answer.\n\n      \"remap\"  (PRIMARY) the oxygen, the H-O-H bisector and the molecular plane are kept\n               exactly, and the two hydrogens are placed at the MODEL's own bond length and\n               angle in that plane, H1 on the side H1 was on.  The model then runs on the\n               geometry it was parameterised for, and the price is the hydrogens' movement,\n               which this function's caller measures and records.\n\n      \"as_is\"  the record's own hydrogens are used unmoved and only the M site is placed,\n               on the record's own bisector at the model's d(OM).  The model runs on a\n               monomer it was never fitted to.  This is the SENSITIVITY leg: the spread\n               between the two rules is the placement's own cost, measured rather than\n               argued.\n\n    Returns `(sites, charges, oxygen_index, hydrogens_moved_bohr)` with `sites` in bohr.\n    ",
  "primary_rule": "remap",
  "force_is_its_own_derivative": {
   "rule": "worst absolute |analytic net force on the acceptor - central difference of the interaction energy under a rigid translation of that molecule| at h = 1e-5 bohr, over every geometry and all three components",
   "h_bohr": 1e-05,
   "bar_hartree_per_bohr": 1e-08,
   "worst": 1.90635285335361e-11,
   "at": "linear_R2.3",
   "pass": true
  }
 },
